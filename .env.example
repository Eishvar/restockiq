# Copy to .env for local development. Never commit real values.

# SQLite locally; Replit PostgreSQL provides DATABASE_URL in production.
DATABASE_URL=sqlite:///./restockiq.db

# "Today" for the demo (defaults to the day after the latest sales date).
TODAY=2026-10-22

# Model used by app/ai/llm.py. Replit-managed Anthropic integration is tried first.
LLM_MODEL=claude-haiku-5-5
ANTHROPIC_API_KEY=

# Shared secret for scheduled jobs (nightly run).
JOB_TOKEN=
