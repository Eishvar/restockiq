modules = ["python-3.12", "nodejs-20", "web", "nix"]

# "Run" button in the workspace: build the web app once, then serve everything from one process.
run = ["sh", "-c", "cd frontend && npm ci && npm run build && cd ../backend && python -m app.seed.load --if-empty && uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000}"]

[nix]
channel = "stable-25_05"

[deployment]
deploymentTarget = "autoscale"
# Replit's Python is read-only and sets PIP_USER, which makes a plain `pip install` fail with "Can not perform a
# '--user' install". So the deployment installs into its own virtualenv (backend/.venv, not in git) and runs from it.
build = ["sh", "-c", "cd frontend && npm ci && npm run build && cd ../backend && python -m venv .venv && PIP_USER=no .venv/bin/pip install -r requirements.txt"]
run = ["sh", "-c", "cd backend && .venv/bin/python -m app.seed.load --if-empty && .venv/bin/python -m uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000}"]

[[ports]]
localPort = 8000
externalPort = 80

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd backend && uvicorn app.main:app --host 0.0.0.0 --port 5000"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"
