modules = ["python-3.11", "nodejs-20", "postgresql-16"]

# "Run" button in the workspace: build the web app once, then serve everything from one process.
run = ["sh", "-c", "cd frontend && npm ci && npm run build && cd ../backend && pip install -r requirements.txt && python -m app.seed.load --if-empty && uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000}"]

[nix]
channel = "stable-24_05"

[deployment]
deploymentTarget = "autoscale"
build = ["sh", "-c", "cd frontend && npm ci && npm run build && cd ../backend && pip install -r requirements.txt"]
run = ["sh", "-c", "cd backend && python -m app.seed.load --if-empty && uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000}"]

[[ports]]
localPort = 8000
externalPort = 80
